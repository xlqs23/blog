---
import SitePage from '../layouts/SitePage.astro';
import { Content, frontmatter } from '../content/pages/about.md';
import { HOME_URL, SITE_DESCRIPTION } from '../consts';
import { localUrl } from '../lib/posts';

const title = typeof frontmatter.title === 'string' && frontmatter.title.trim()
  ? frontmatter.title.trim()
  : '关于';
---
<SitePage title={title} description={SITE_DESCRIPTION}>
  <main id="main" class="container collection-page info-page">
    <h1>{title}</h1>
    <div class="about-body"><Content /></div>
    <div class="profile-links"><a class="profile-chip" href={HOME_URL}>个人主页</a><a class="profile-chip" href={localUrl('all/')}>浏览文章</a></div>
  </main>
</SitePage>

<style>
  .about-body { overflow-wrap: anywhere; }
  .about-body :global(pre) { overflow-x: auto; }
</style>
