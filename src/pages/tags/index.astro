---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { visiblePosts, tagUrl } from '../../lib/posts';
const posts = await visiblePosts();
const counts = new Map<string, number>();
for (const post of posts) for (const tag of new Set(post.data.tags)) counts.set(tag, (counts.get(tag) || 0) + 1);
const tags = [...counts].sort(([a], [b]) => a.localeCompare(b, 'zh-CN'));
---
<!doctype html>
<html lang="zh-CN"><head><BaseHead title="文章标签" description="按主题发现文章。" /></head><body><Header /><main id="main" class="container collection-page"><p class="eyebrow">TOPICS</p><h1>从一个主题开始。</h1><p class="muted">按标签浏览文章，找到你感兴趣的内容。</p><div class="topic-list">{tags.map(([tag, count]) => <a href={tagUrl(tag)}><span>{tag}</span><span>{count} 篇</span></a>)}</div>{tags.length === 0 && <p class="empty-state">暂时没有标签。</p>}</main><Footer /></body></html>
