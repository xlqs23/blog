---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { localUrl, visiblePosts } from '../lib/posts';
const posts = await visiblePosts();
---
<!doctype html>
<html lang="zh-CN"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head><body><Header />
  <main id="main" class="container">
    <section class="intro"><p class="eyebrow">NOTES & IDEAS</p><h1>把思考，<br />慢慢写下来。</h1><p class="intro-description">{SITE_DESCRIPTION}</p><a class="text-link" href={localUrl('rss.xml')}>通过 RSS 订阅更新</a><div class="intro-decoration" aria-hidden="true"><span></span><span></span><span></span><span></span></div></section>
    <section aria-labelledby="posts-title">
      <div class="section-top"><div><p class="eyebrow">THE JOURNAL</p><h2 id="posts-title">全部文章 <span>{posts.length}</span></h2></div><label class="search-box"><span class="sr-only">搜索文章标题、摘要或标签</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="search" type="search" placeholder="搜索文章…" autocomplete="off" /></label></div>
      <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div><p id="empty-state" class="empty-state" hidden={posts.length > 0} aria-live="polite">暂时没有文章。</p>
    </section>
  </main><Footer />
  <script>
    const search = document.querySelector<HTMLInputElement>('#search');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post]'));
    const empty = document.querySelector<HTMLElement>('#empty-state');
    search?.addEventListener('input', () => {
      const query = search.value.trim().toLocaleLowerCase();
      for (const card of cards) card.hidden = !card.dataset.search?.includes(query);
      if (empty) { empty.hidden = cards.some((card) => !card.hidden); empty.textContent = query ? '没有找到匹配的文章，试试其他关键词。' : '暂时没有文章。'; }
    });
  </script>
</body></html>
