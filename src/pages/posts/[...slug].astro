---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import EncryptedPost from '../../components/EncryptedPost.astro';
import { visiblePosts } from '../../lib/posts';
export async function getStaticPaths() { return (await visiblePosts()).map((post) => ({ params: { slug: post.id }, props: post })); }
type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const rendered = post.data.encrypted ? null : await render(post);
const Content = rendered?.Content;
---
<BlogPost {...post.data} headings={rendered?.headings ?? []}>
  {post.data.encrypted && post.data.encryption
    ? <EncryptedPost postId={post.id} encryption={post.data.encryption} />
    : Content && <Content />}
</BlogPost>
