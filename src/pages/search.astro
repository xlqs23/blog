---
import SitePage from '../layouts/SitePage.astro';
import PostCard from '../components/PostCard.astro';
import { localUrl, visiblePosts } from '../lib/posts';
const posts = await visiblePosts();
---
<SitePage title="搜索" description="搜索文章标题、标签或正文。">
  <main id="main" class="container collection-page search-page">
    <h1>搜索</h1>
    <form class="search-form" role="search" data-index={localUrl('search-index.json')}>
      <label for="search">搜索标题、标签或正文</label>
      <input id="search" name="q" type="search" placeholder="输入关键词" autocomplete="off" />
    </form>
    <p class="post-summary" id="search-status" role="status">共 {posts.length} 篇文章</p>
    <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
    <noscript><p class="muted">开启 JavaScript 后即可搜索正文。<a href={localUrl('all/')}>浏览全部文章</a>。</p></noscript>
  </main>
</SitePage>
<script>
  const form = document.querySelector<HTMLFormElement>('.search-form');
  const search = document.querySelector<HTMLInputElement>('#search');
  const status = document.querySelector('#search-status');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post]'));
  let searchIndex: Promise<Map<string, string>> | undefined;

  function loadIndex() {
    searchIndex ??= fetch(form?.dataset.index ?? '')
      .then(async (response) => {
        if (!response.ok) throw new Error('索引读取失败');
        const items: { id: string; text: string }[] = await response.json();
        return new Map(items.map(({ id, text }) => [id, text]));
      })
      .catch(() => new Map<string, string>());
    return searchIndex;
  }

  async function runSearch() {
    if (!search || !status) return;
    const query = search.value.trim().toLocaleLowerCase();
    const terms = query.split(/\s+/).filter(Boolean);
    const index = terms.length ? await loadIndex() : undefined;
    if (search.value.trim().toLocaleLowerCase() !== query) return;
    let matches = 0;
    for (const card of cards) {
      const text = index?.get(card.dataset.post ?? '') ?? card.dataset.search ?? '';
      card.hidden = !terms.every((term) => text.includes(term));
      if (!card.hidden) matches++;
    }
    status.textContent = query ? (matches ? `找到 ${matches} 篇文章` : '没有找到匹配的文章。') : `共 ${cards.length} 篇文章`;
  }

  search?.addEventListener('input', runSearch);
  form?.addEventListener('submit', (event) => { event.preventDefault(); void runSearch(); });
  const query = new URLSearchParams(location.search).get('q');
  if (search && query) { search.value = query; void runSearch(); }
</script>
