---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { localUrl, mediaUrl } from '../lib/posts';
interface Props { title: string; description: string; image?: string; noindex?: boolean }
const { title, description, image, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#fbfdfc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#171e1c" media="(prefers-color-scheme: dark)" />
<script is:inline>
  (() => {
    let theme;
    try { theme = localStorage.getItem('xlqs-blog-theme'); } catch {}
    document.documentElement.dataset.theme = theme === 'light' || theme === 'dark'
      ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  })();
</script>
<title>{title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="icon" type="image/svg+xml" href={localUrl('favicon.svg')} />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href={localUrl('sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={localUrl('rss.xml')} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(mediaUrl(image), Astro.site)} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
