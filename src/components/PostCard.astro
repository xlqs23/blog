---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { mediaUrl, postUrl, tagUrl } from '../lib/posts';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, description, pubDate, tags, draft, heroImage } = post.data;
---
<article class:list={['post-card', { 'with-cover': !!heroImage }]} data-post data-search={`${title} ${description} ${tags.join(' ')}`.toLocaleLowerCase()}>
  {heroImage && <a class="card-cover" href={postUrl(post.id)} tabindex="-1" aria-hidden="true"><img src={mediaUrl(heroImage)} alt="" loading="lazy" /></a>}
  <div class="post-card-body"><div class="post-meta"><FormattedDate date={pubDate} />{draft && <span class="draft-label">草稿 · 仅本地可见</span>}</div><h2><a href={postUrl(post.id)}>{title}</a></h2>{description && <p>{description}</p>}<div class="tags">{tags.map((tag) => <a href={tagUrl(tag)}>{tag}</a>)}</div></div>
</article>
