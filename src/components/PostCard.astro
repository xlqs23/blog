---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { localUrl, mediaUrl, postUrl, tagUrl } from '../lib/posts';
import { categoryFor } from '../lib/categories';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, description, pubDate, tags, draft, heroImage, encrypted } = post.data;
const category = categoryFor(post.data);
---
<article class:list={['post-card', { 'with-cover': !encrypted && !!heroImage }]} data-post={post.id} data-search={`${title} ${description} ${tags.join(' ')} ${category.label}`.toLocaleLowerCase()}>
  {!encrypted && heroImage && <div class="card-cover" aria-hidden="true"><img src={mediaUrl(heroImage)} alt="" loading="lazy" decoding="async" /></div>}
  <div class="post-card-body">
    <div class="post-meta"><FormattedDate date={pubDate} />{draft && <span class="draft-label">草稿 · 仅本地可见</span>}{encrypted && <span class="encrypted-label">🔒 加密</span>}</div>
    <h2><a class="post-card-link" href={postUrl(post.id)}>{title}</a></h2>
    {description && <p>{description}</p>}
    <div class="post-card-footer">
      <a class="post-category" href={localUrl(`${category.route}/`)}>{category.label}</a>
      {tags.length > 0 && <div class="tags">{tags.map((tag) => <a href={tagUrl(tag)}>{tag}</a>)}</div>}
    </div>
  </div>
  <svg class="post-card-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
</article>
